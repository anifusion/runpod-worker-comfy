# GitHub Actions configuration for runpod-worker-comfy
#
# This file is documentation only — do not put real secrets here or commit filled-in values.
#
# Where to add values:
#   Repository secrets: GitHub → your repo → Settings → Secrets and variables → Actions → Secrets
#   Repository variables: same page → Variables tab (non-sensitive)
#
# Workflows:
#   dev.yml — Docker Hub build/push on non-main branches
#   release.yml — semantic-release + Docker Hub on main (extra secret below)
#   test.yml — no GitHub secrets or variables
#
# --- Repository secrets (dev.yml + release.yml) ---

DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Hugging Face token passed as Docker build arg
HUGGINGFACE_ACCESS_TOKEN=

# --- Repository secrets (release.yml only) ---

# GitHub PAT with repo write access; passed to semantic-release as GITHUB_TOKEN
BLIBLA_SEMANTIC_RELEASE=

# --- Repository variables (not secrets) ---

DOCKERHUB_REPO=
DOCKERHUB_IMG=
